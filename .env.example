# Painel do Supabase > Project Settings > API Keys
#
# O projeto usa o formato novo de chaves (sb_publishable_... e sb_secret_...),
# nao o par legado anon/service_role em JWT. Os dois funcionam, mas nao
# misture: pegue ambas na mesma aba para nao acabar com uma chave de um
# projeto e outra de outro.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key (equivale a service_role): IGNORA RLS por completo.
# So em .env.local e nas variaveis da Vercel. Nunca commitar.
#
# Atencao ao salvar o .env.local no Bloco de Notas do Windows: ele acrescenta
# .txt sem avisar. O .gitignore ja cobre esse caso, mas o Next.js so le
# .env.local — um .env.local.txt e ignorado silenciosamente.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo da rota POST /api/revalidar. Valor aleatorio longo, gerado por voce
# (ex.: `node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"`).
# Precisa existir tambem nas variaveis da Vercel, senao a rota devolve 500.
REVALIDATE_SECRET=
